{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "portfolio", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "portfolio-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd portfolio && npm run build && npm run preview -- --port 4173"],
      "port": 4173
    }
  ]
}
